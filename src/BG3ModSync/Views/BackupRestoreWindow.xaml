<Window x:Class="BG3ModSync.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="680" Height="600"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WinUiWindowBg}"
        Foreground="{StaticResource WinUiTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Current Mods Summary -->
        <Border Grid.Row="0" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="BACKUP &amp; RESTORE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WinUiAccentGold}" />
                    <TextBlock x:Name="StatsTextBlock" Text="Scanning Mods..." FontSize="13" Foreground="{StaticResource WinUiTextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#2E2618" BorderBrush="#6B5322" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                        ToolTip="If you use Nexus Vortex, click Purge Mods in Vortex before creating a backup, and click Deploy after restoring.">
                    <TextBlock Text="⚠ Vortex: Purge before Backup" FontSize="11.5" Foreground="#FFD579" />
                </Border>
            </Grid>
        </Border>

        <!-- Backup Storage Location -->
        <Border Grid.Row="1" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Backup Location" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WinUiAccentCyan}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="UseDriveRadio" Content="Drive:" GroupName="BackupLocMode"
                                 ToolTip="Store backups automatically in Drive:\BG3MOD on the selected disk."
                                 Foreground="{StaticResource WinUiTextPrimary}" VerticalAlignment="Center"
                                 Checked="BackupModeRadio_Changed" />
                    <ComboBox x:Name="DriveComboBox" Grid.Column="1" Height="32"
                              DisplayMemberPath="DisplayLabel"
                              ToolTip="Select which drive to store mod backups on."
                              SelectionChanged="DriveComboBox_SelectionChanged" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="UseCustomPathRadio" Content="Custom Folder:" GroupName="BackupLocMode"
                                 ToolTip="Choose any custom folder path to store your mod backups."
                                 Foreground="{StaticResource WinUiTextPrimary}" VerticalAlignment="Center"
                                 Checked="BackupModeRadio_Changed" />
                    <TextBox x:Name="CustomBackupPathBox" Grid.Column="1" Style="{StaticResource WinUiTextBoxStyle}"
                             ToolTip="Custom directory path for storing mod backups."
                             TextChanged="CustomBackupPathBox_TextChanged" />
                    <Button x:Name="BrowseCustomBackupBtn" Grid.Column="2" Content="Browse"
                            ToolTip="Browse and select a custom backup folder."
                            Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Click="BrowseCustomBackupBtn_Click" />
                    <Button x:Name="OpenBackupFolderBtn" Grid.Column="3" Content="Open"
                            ToolTip="Open the active backup folder in Windows Explorer."
                            Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Click="OpenBackupFolderBtn_Click" />
                </Grid>

                <TextBlock x:Name="ActiveBackupRootText" Text="Path: C:\BG3MOD" FontSize="11.5" Foreground="{StaticResource WinUiTextMuted}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Create New Backup Section -->
        <Border Grid.Row="2" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name:" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0" />
                <TextBox x:Name="BackupNameTextBox" Grid.Column="1" Style="{StaticResource WinUiTextBoxStyle}"
                         ToolTip="Enter a name for the new backup (e.g., Vanilla, Patch7, Multiplayer)." />
                <Button x:Name="CreateBackupBtn" Grid.Column="2" Content="＋ Backup"
                        ToolTip="Create a new backup of your current Mods, modsettings.lsx, and Script Extender files."
                        Style="{StaticResource WinUiAccentButtonStyle}" Margin="10,0,0,0" Padding="16,8"
                        Click="CreateBackupBtn_Click" />
            </Grid>
        </Border>

        <!-- Existing Backups List -->
        <Border Grid.Row="3" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Saved Backups" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WinUiAccentCyan}" VerticalAlignment="Center" />
                    <Button Content="↻ Refresh" ToolTip="Reload saved backups from the backup folder." Style="{StaticResource WinUiButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="RefreshBtn_Click" />
                </Grid>
                <ListBox x:Name="BackupsListBox" Grid.Row="1"
                         Background="#1B1B1B" Foreground="{StaticResource WinUiTextPrimary}"
                         BorderBrush="#383838" BorderThickness="1"
                         DisplayMemberPath="DisplaySummary"
                         ToolTip="Select a saved backup to restore or delete."
                         FontSize="13" Padding="6" />
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DeleteAfterRestoreCheckBox" Grid.Column="0"
                      Content="Delete after restore"
                      ToolTip="If checked, removes the backup folder after restoring its files to save disk space."
                      IsChecked="True"
                      Foreground="{StaticResource WinUiTextSecondary}"
                      VerticalAlignment="Center" />

            <Button x:Name="RestoreBackupBtn" Grid.Column="2" Content="⤓ Restore"
                    ToolTip="Restore the selected backup into your Baldur's Gate 3 Mods folder."
                    Style="{StaticResource WinUiAccentButtonStyle}" Margin="0,0,8,0"
                    Click="RestoreBackupBtn_Click" />
            <Button x:Name="DeleteBackupBtn" Grid.Column="3" Content="🗑 Delete"
                    ToolTip="Permanently delete the selected backup folder."
                    Style="{StaticResource WinUiButtonStyle}" Foreground="#FF7A7A" Margin="0,0,8,0"
                    Click="DeleteBackupBtn_Click" />
            <Button Grid.Column="4" Content="Close" ToolTip="Close this window." Style="{StaticResource WinUiButtonStyle}" Click="CloseBtn_Click" />
        </Grid>
    </Grid>
</Window>
