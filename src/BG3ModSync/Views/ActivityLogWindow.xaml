<Window x:Class="BG3ModSync.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3Mod Sync — Detailed Activity Log"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="860" Height="560"
        MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WinUiWindowBg}"
        Foreground="{StaticResource WinUiTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📜 ACTIVITY LOG" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WinUiAccentCyan}" />
                <TextBlock Text="Real-time diagnostic &amp; file transfer console" FontSize="12" Foreground="{StaticResource WinUiTextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 Copy All"
                        ToolTip="Copy all log messages to clipboard."
                        Style="{StaticResource WinUiButtonStyle}"
                        Padding="12,5" FontSize="12" Margin="0,0,8,0"
                        Click="CopyLogBtn_Click" />
                <Button Content="🗑 Clear"
                        ToolTip="Clear the activity log."
                        Style="{StaticResource WinUiButtonStyle}"
                        Padding="12,5" FontSize="12"
                        Click="ClearLogBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Log TextBox -->
        <TextBox x:Name="LogConsoleTextBox"
                 Grid.Row="1"
                 Background="#0F0F0F"
                 Foreground="#E2E8F0"
                 BorderBrush="#2D2D2D"
                 BorderThickness="1"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 FontSize="12.5"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="10"
                 AcceptsReturn="True" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource WinUiButtonStyle}"
                    Padding="18,6"
                    Click="CloseBtn_Click" />
        </Grid>
    </Grid>
</Window>
