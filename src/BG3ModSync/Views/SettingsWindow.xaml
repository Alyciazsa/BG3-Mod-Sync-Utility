<Window x:Class="BG3ModSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game &amp; Mod Folder Locations"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="660" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WinUiWindowBg}"
        Foreground="{StaticResource WinUiTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderTitleText" Text="GAME &amp; MOD LOCATIONS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WinUiAccentCyan}" Margin="0,0,0,4" />
        <TextBlock x:Name="HeaderSubtitleText"
                   Text="Please verify that the auto-detected Mods (Larian AppData) and Baldur's Gate 3 Game folders are correct."
                   FontSize="12.5" Foreground="{StaticResource WinUiTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <!-- Larian Studios AppData Folder -->
        <Border Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="1. Larian AppData Folder (Mods &amp; Load Order):" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WinUiTextPrimary}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LarianPathTextBox" Grid.Column="0" Style="{StaticResource WinUiTextBoxStyle}"
                             TextChanged="LarianPathTextBox_TextChanged"
                             ToolTip="Path to %LOCALAPPDATA%\Larian Studios\Baldur's Gate 3 (contains Mods, PlayerProfiles, and Script Extender)." />
                    <Button Grid.Column="1" Content="Browse" ToolTip="Browse for the Larian Studios Baldur's Gate 3 AppData folder." Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Click="BrowseLarianBtn_Click" />
                    <Button Grid.Column="2" Content="Auto" ToolTip="Automatically detect the default Larian AppData path." Style="{StaticResource WinUiButtonStyle}" Margin="6,0,0,0" Click="ResetLarianBtn_Click" />
                </Grid>
                <TextBlock x:Name="LarianValidationText" Text="✓ Verified Mods folder" FontSize="11.5" Foreground="#6CCB5F" Margin="2,6,0,0" />
            </StackPanel>
        </Border>

        <!-- BG3 Game Install Directory -->
        <Border Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="2. BG3 Install Folder (e.g. X:\000.gaming\steam\steamapps\common\Baldurs Gate 3):" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WinUiTextPrimary}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Bg3InstallPathTextBox" Grid.Column="0" Style="{StaticResource WinUiTextBoxStyle}"
                             TextChanged="Bg3InstallPathTextBox_TextChanged"
                             ToolTip="Path to your Baldur's Gate 3 installation directory (checks ..\Baldurs Gate 3\bin\bg3.exe)." />
                    <Button Grid.Column="1" Content="Browse" ToolTip="Browse for the Baldur's Gate 3 installation folder." Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Click="BrowseBg3InstallBtn_Click" />
                    <Button Grid.Column="2" Content="Auto" ToolTip="Automatically detect the Baldur's Gate 3 install path from Steam/Registry." Style="{StaticResource WinUiButtonStyle}" Margin="6,0,0,0" Click="ResetBg3InstallBtn_Click" />
                </Grid>
                <TextBlock x:Name="Bg3ValidationText" Text="Checking ..\Baldurs Gate 3\bin\bg3.exe..." FontSize="11.5" Foreground="#6CCB5F" Margin="2,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveConfirmBtn" Content="✔ Confirm &amp; Save" ToolTip="Confirm and save folder locations." Style="{StaticResource WinUiAccentButtonStyle}" Padding="18,8" Margin="0,0,8,0" Click="SaveBtn_Click" />
            <Button x:Name="CancelBtn" Content="Cancel" ToolTip="Close without saving." Style="{StaticResource WinUiButtonStyle}" Padding="16,8" Click="CancelBtn_Click" />
        </StackPanel>
    </StackPanel>
</Window>
