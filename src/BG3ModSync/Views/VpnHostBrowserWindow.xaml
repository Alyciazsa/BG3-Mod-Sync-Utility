<Window x:Class="BG3ModSync.Views.VpnHostBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Host — VPN Network Browser"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="620" Height="460"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WinUiWindowBg}"
        Foreground="{StaticResource WinUiTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Active VPN Summary Card -->
        <Border Grid.Row="0" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="FIND HOST — VPN NETWORK BROWSER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WinUiAccentGold}" />
                <TextBlock x:Name="VpnAdapterStatusText" Text="Scanning active VPN adapters..." FontSize="12.5" Foreground="{StaticResource WinUiTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Header & Refresh -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="HostsCountHeaderText" Text="Online BG3ModSync Hosts (0)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ScanStateText" Text="Scanning..." FontSize="12" Foreground="{StaticResource WinUiAccentCyan}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="RefreshHostsBtn" Content="↻ Refresh"
                        ToolTip="Rescan all active VPN networks for online BG3ModSync hosts."
                        Style="{StaticResource WinUiButtonStyle}" Padding="10,6"
                        Click="RefreshHostsBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Discovered VPN Hosts List -->
        <Border Grid.Row="2" Background="#1B1B1B" BorderBrush="#383838" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <TextBlock x:Name="EmptyStateText"
                           Text="Scanning active VPN interfaces (Tailscale, ZeroTier, NetBird, Radmin VPN, Hamachi, WireGuard, OpenVPN)..."
                           FontSize="12.5"
                           Foreground="{StaticResource WinUiTextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="28" />

                <ListBox x:Name="HostsListBox"
                         Background="Transparent"
                         Foreground="{StaticResource WinUiTextPrimary}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ToolTip="Double-click an online VPN host or click Select Host to auto-fill its IP and port."
                         MouseDoubleClick="HostsListBox_MouseDoubleClick"
                         Padding="6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemCard"
                                                Background="#222730"
                                                BorderBrush="#343D4D"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemCard" Property="Background" Value="#2A3240" />
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#4D5D75" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemCard" Property="Background" Value="#19324A" />
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#60CDFF" />
                                                <Setter TargetName="ItemCard" Property="BorderThickness" Value="1.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <Border Background="#1B3042" BorderBrush="#3B7BA8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProviderBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding EndpointDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#E6B85C" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                        <TextBlock Text="  •  " FontSize="11.5" Foreground="{StaticResource WinUiTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusSummary}" FontSize="11.5" Foreground="{StaticResource WinUiTextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#12261A" BorderBrush="#285E3B" BorderThickness="1" CornerRadius="5" Padding="9,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PingDisplay}" FontSize="12" FontWeight="Bold" Foreground="#6CCB5F" FontFamily="Cascadia Mono, Consolas" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectHostBtn" Grid.Column="0" Content="🎯 Select Host"
                    ToolTip="Set the selected VPN host IP and port as your Client Sync target."
                    Style="{StaticResource WinUiAccentButtonStyle}"
                    Click="SelectHostBtn_Click" />
            <Button Grid.Column="2" Content="Close"
                    ToolTip="Close this window."
                    Style="{StaticResource WinUiButtonStyle}"
                    Click="CloseBtn_Click" />
        </Grid>
    </Grid>
</Window>
