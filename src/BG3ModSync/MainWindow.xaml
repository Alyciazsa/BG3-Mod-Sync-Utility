<Window x:Class="BG3ModSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3Mod Sync"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1020" Height="790"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WinUiWindowBg}"
        Foreground="{StaticResource WinUiTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">

    <Grid Margin="20,16,20,10">
        <Grid.RowDefinitions>
            <!-- 0: Header & Live Status Card -->
            <RowDefinition Height="Auto" />
            <!-- 1: 2 Big Buttons on Top (HOST / CLIENT) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Mode Selector + IP Row + Target/Port Row + Progress -->
            <RowDefinition Height="Auto" />
            <!-- 3: Detailed Activity Log -->
            <RowDefinition Height="*" />
            <!-- 4: Bottom Feature Buttons -->
            <RowDefinition Height="Auto" />
            <!-- 5: Footer Credit Link -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header Banner, Top-Middle Play Button & Top-Right Status Box -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center"
                        BorderBrush="#60CDFF" BorderThickness="1.5" ClipToBounds="True"
                        ToolTip="BG3Mod Sync — Zero-Copy Portable Nginx HTTP &amp; Steam P2P">
                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BG3 MOD SYNC" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WinUiAccentGold}" />
                        <Border Background="#2A3442" BorderBrush="#3E5879" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Serves mod files directly from disk via Portable Nginx HTTP and Steam P2P without copying files.">
                            <TextBlock Text="Nginx HTTP + Steam P2P" FontSize="11.5" Foreground="{StaticResource WinUiAccentCyan}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubHeaderInfoText"
                               Text="Hover mouse over any button or option for details"
                               FontSize="12" Foreground="{StaticResource WinUiTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Top-Middle PLAY GAME Button + Vulkan (bg3.exe) / DX11 (bg3_dx11.exe) Tick Choice -->
            <Border Grid.Column="1" Background="#1D2820" BorderBrush="#499C54" BorderThickness="1.5" CornerRadius="9" Padding="14,7" Margin="12,0" VerticalAlignment="Center"
                    ToolTip="Un-hooks Steam API so Steam returns to 'Online' (not playing any game), then launches Baldur's Gate 3.">
                <StackPanel HorizontalAlignment="Center">
                    <Button x:Name="PlayGameTopBtn"
                            Style="{StaticResource WinUiAccentButtonStyle}"
                            Background="#287D3C"
                            BorderBrush="#6CCB5F"
                            Padding="22,6"
                            HorizontalAlignment="Center"
                            ToolTip="Click to unhook Steam status back to Online and launch Baldur's Gate 3 with the selected graphics API."
                            Click="PlayGameTopBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▶ PLAY BG3" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <RadioButton x:Name="PlayVulkanRadio"
                                     GroupName="LaunchApiGroup"
                                     Content="Vulkan (bg3.exe)"
                                     FontSize="11.5"
                                     Foreground="#E2E8F0"
                                     Margin="0,0,12,0"
                                     IsChecked="True"
                                     Checked="PlayApiRadio_Changed"
                                     ToolTip="Launch Baldur's Gate 3 using Vulkan API (bin\bg3.exe)." />
                        <RadioButton x:Name="PlayDx11Radio"
                                     GroupName="LaunchApiGroup"
                                     Content="DX11 (bg3_dx11.exe)"
                                     FontSize="11.5"
                                     Foreground="#E2E8F0"
                                     Checked="PlayApiRadio_Changed"
                                     ToolTip="Launch Baldur's Gate 3 using DirectX 11 API (bin\bg3_dx11.exe)." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Top-Right Live Server & Connection Source / Route Card -->
            <Border Grid.Column="2" HorizontalAlignment="Right" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" MinWidth="295"
                    ToolTip="Shows live Server state, active connection route (Direct P2P / Direct IP / Steam Relay), and nearest Valve relay server ping.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ServerStatusDot" Grid.Column="0" Width="11" Height="11" Fill="#8A8A8A" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ServerStatusTitle" Text="Server: Idle" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource WinUiTextPrimary}" />
                        <TextBlock x:Name="ConnectionRouteText" Text="Route: Standby" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WinUiAccentCyan}" Margin="0,2,0,0" />
                        <TextBlock x:Name="SteamBadgeText" Text="Steam: Checking..." FontSize="11" Foreground="{StaticResource WinUiTextMuted}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 1: TWO BIG HERO BUTTONS ON TOP (HOST & CLIENT) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- BIG BUTTON 1: HOST -->
            <Button x:Name="HostBigButton" Grid.Column="0" Height="92"
                    Style="{StaticResource WinUiHeroButtonStyle}"
                    ToolTip="Generate ModHash.txt with direct file locations and start hosting your mods via Portable Nginx HTTP and Steam P2P (zero files copied)."
                    Click="HostBigButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                            Background="#1B3A4B" BorderBrush="#60CDFF" BorderThickness="1.5"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="📡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HostBtnTitle" Text="HOST" FontSize="20" FontWeight="Bold" Foreground="#60CDFF" />
                        <TextBlock x:Name="HostBtnSubtitle"
                                   Text="Start Mod Server"
                                   FontSize="12.5" Foreground="{StaticResource WinUiTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- BIG BUTTON 2: CLIENT -->
            <Button x:Name="ClientBigButton" Grid.Column="2" Height="92"
                    Style="{StaticResource WinUiHeroButtonStyle}"
                    ToolTip="Connect to the Host server, compare local files against Host ModHash.txt, download missing/updated mods, and remove obsolete files."
                    Click="ClientBigButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                            Background="#1E3A2B" BorderBrush="#6CCB5F" BorderThickness="1.5"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ClientBtnTitle" Text="CLIENT" FontSize="20" FontWeight="Bold" Foreground="#6CCB5F" />
                        <TextBlock x:Name="ClientBtnSubtitle"
                                   Text="Sync Mods from Host"
                                   FontSize="12.5" Foreground="{StaticResource WinUiTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- 2: Separate Connection Mode Selector + New-Line Selectable IP Row + Target Input + Left-to-Center Progress -->
        <Border Grid.Row="2" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <!-- Line 1: Connection Mode Selector -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Mode:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WinUiAccentGold}" Margin="0,0,16,0"
                               ToolTip="Choose how Host and Client connect together." />

                    <RadioButton x:Name="ModeSteamP2PRadio" Grid.Column="1" GroupName="ConnModeGroup"
                                 Content="🌐 Steam P2P"
                                 ToolTip="Connect via Steam Room Code (BG3-...) or SteamID64. Automatically negotiates Direct HTTP handoff or punches a direct UDP hole through NAT."
                                 Foreground="{StaticResource WinUiTextPrimary}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,22,0"
                                 Checked="ConnModeRadio_Changed" />

                    <RadioButton x:Name="ModeWanLanIpRadio" Grid.Column="2" GroupName="ConnModeGroup"
                                 Content="🌍 Direct IP"
                                 ToolTip="Connect directly via Public WAN IP (with UPnP / Port Forwarding) or Local LAN IP."
                                 Foreground="{StaticResource WinUiTextPrimary}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,22,0"
                                 Checked="ConnModeRadio_Changed" />

                    <RadioButton x:Name="ModeVpnIpRadio" Grid.Column="3" GroupName="ConnModeGroup"
                                 Content="🛡️ VPN IP"
                                 ToolTip="Connect directly via virtual VPN interface IP (Tailscale, ZeroTier, NetBird, Radmin VPN, Hamachi, WireGuard, OpenVPN). Hosts broadcast on VPN; click Find Host to browse online hosts."
                                 Foreground="{StaticResource WinUiTextPrimary}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Checked="ConnModeRadio_Changed" />
                </Grid>

                <!-- Line 2 (New Line): Selectable IP Box (Hidden automatically when Steam Mode is selected) -->
                <Grid x:Name="SelectableIpRow" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectableIpLabel" Grid.Column="0" Text="Interface:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WinUiAccentCyan}" Margin="0,0,12,0"
                               ToolTip="Select one of your available network interfaces." />

                    <ComboBox x:Name="InterfacesComboBox" Grid.Column="1" Height="32"
                              DisplayMemberPath="DisplaySummary"
                              FontSize="12.5"
                              ToolTip="Choose an available WAN, LAN, or VPN network interface IP."
                              SelectionChanged="InterfacesComboBox_SelectionChanged" />

                    <Button x:Name="UpnpForwardBtn" Grid.Column="2" Content="📡 UPnP"
                            ToolTip="Automatically forward the selected TCP port on your router via UPnP for WAN hosting."
                            Style="{StaticResource WinUiButtonStyle}" Padding="12,6" FontSize="12" Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="UpnpForwardBtn_Click" />

                    <Button x:Name="RefreshInterfacesBtn" Grid.Column="3" Content="↻ Refresh"
                            ToolTip="Rescan all WAN, LAN, and VPN network interfaces on this PC."
                            Style="{StaticResource WinUiButtonStyle}" Padding="12,6" FontSize="12" Margin="8,0,0,0"
                            Click="RefreshInterfacesBtn_Click" />
                </Grid>

                <!-- Line 3: Target Input + Single Port Box (Default 27000) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TargetInputLabel" Grid.Column="0" Text="Room / ID:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBox x:Name="HostTargetTextBox" Grid.Column="1" Style="{StaticResource WinUiTextBoxStyle}"
                             TextChanged="HostTargetTextBox_TextChanged"
                             ToolTip="Enter Host Room Code (BG3-...), SteamID64, WAN/LAN IP, or VPN IP." />

                    <TextBlock x:Name="PortLabel" Grid.Column="2" Text="Port:" VerticalAlignment="Center" FontSize="13" Margin="12,0,6,0"
                               ToolTip="TCP Port for Host Nginx server (Default: 27000)." />
                    <TextBox x:Name="NginxPortBox" Grid.Column="3" Width="76" Style="{StaticResource WinUiTextBoxStyle}" Text="27000"
                             TextChanged="NginxPortBox_TextChanged"
                             ToolTip="Host Nginx HTTP port (Default: 27000). Changing waits 5 seconds to finalize, dynamically restarts Nginx, and updates UPnP." />

                    <Button x:Name="CopyHostInfoBtn" Grid.Column="4" Content="📋 Copy Code"
                            ToolTip="Copy your current Room Code or selected IP address to clipboard."
                            Style="{StaticResource WinUiButtonStyle}" Margin="10,0,0,0" Padding="11,6"
                            Click="CopyHostInfoBtn_Click" />
                    <Button x:Name="CopySteamIdBtn" Grid.Column="5" Content="🆔 SteamID"
                            ToolTip="Copy your permanent 17-digit SteamID64 to clipboard."
                            Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Padding="11,6"
                            Click="CopySteamIdBtn_Click" />
                    <Button x:Name="SelectHostBtn" Grid.Column="6" Content="🎯 Select Host"
                            ToolTip="Select an online Steam friend using the same Game / AppID as your Host."
                            Style="{StaticResource WinUiButtonStyle}" Margin="8,0,0,0" Padding="11,6"
                            Click="SelectHostBtn_Click" />
                </Grid>

                <!-- Yellow Warning Alert when Steam Relay Mode is Active -->
                <Border x:Name="RelayWarningBanner"
                        Background="#33280F"
                        BorderBrush="#9E7B22"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RelayWarningText"
                               Text="⚠ Relay mode active — transfer speed is slower than Direct P2P or Direct IP."
                               Foreground="#FFD86B"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Line 4: Progress Bar (Starts from Left, Ends at Center of the App; Progress Text Starts at Center) -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="MainProgressBar" Grid.Column="0"
                                 Height="10" Minimum="0" Maximum="100" Value="0"
                                 HorizontalAlignment="Stretch"
                                 Background="#161616" Foreground="#60CDFF" BorderThickness="0"
                                 ToolTip="Current operation progress." />

                    <TextBlock x:Name="ProgressStatusText" Grid.Column="1"
                               Text="Ready" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource WinUiTextSecondary}"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3: Session Lobby Box (Host on Top with Golden Crown + Connected Clients & Real-Time Sync Progress) -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Lobby Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SESSION LOBBY" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource WinUiAccentCyan}" />
                        <TextBlock x:Name="HostShareSummaryText" Text="" FontSize="12" Foreground="{StaticResource WinUiAccentGold}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LobbyStatusSummaryText" Text="Waiting for session..." FontSize="11.5" Foreground="{StaticResource WinUiTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- HOST ROW (Top of Lobby with Golden Crown — Shown when HOST or CLIENT is clicked) -->
                <Border x:Name="HostLobbyCardBorder" Grid.Row="1" Visibility="Collapsed" Background="#1C1912" BorderBrush="#66F59E0B" BorderThickness="1.5" CornerRadius="7" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Golden Crown -->
                        <TextBlock Grid.Column="0" Text="👑" FontSize="22" Foreground="#FFD700" VerticalAlignment="Center" Margin="2,0,10,0" ToolTip="Session Host" />

                        <!-- Steam Profile Pic / Avatar (or '?' in Direct IP / VPN mode) -->
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="6" Background="#262626" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="HostLobbyAvatarFallback" Text="?" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F59E0B" />
                                <Image x:Name="HostLobbyAvatarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <!-- Host Name, SteamID, Handshaked IP:Port -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#382B0F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,7,0">
                                    <TextBlock Text="HOST" FontSize="10" FontWeight="Bold" Foreground="#FFD700" />
                                </Border>
                                <TextBlock x:Name="HostLobbyNameText" Text="Not Active" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <TextBlock x:Name="HostLobbyIdText" Text="" FontSize="11.5" Foreground="#CBD5E1" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Endpoint: " FontSize="11.5" Foreground="{StaticResource WinUiTextMuted}" />
                                <TextBlock x:Name="HostLobbyIpPortText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="#60CDFF" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock x:Name="HostLobbyStateText" Text="  •  Idle" FontSize="11.5" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Host Ping & Live Transfer Speed (Hidden when local user is Host; shown when local user is Client) -->
                        <StackPanel x:Name="HostLobbyStatsPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#12261A" BorderBrush="#285E3B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ping: " FontSize="11.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="HostLobbyPingText" Text="—" FontSize="12" FontWeight="Bold" Foreground="#6CCB5F" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                            </Border>
                            <Border Background="#112233" BorderBrush="#1E4976" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Speed: " FontSize="11.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="HostLobbySpeedText" Text="0.0 MB/s" FontSize="12" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONNECTED CLIENTS LIST (with Real-Time Client -> Host Sync Progress Bar) -->
                <Border Grid.Row="2" Background="#0F0F0F" BorderBrush="#262626" BorderThickness="1" CornerRadius="7" Padding="8">
                    <Grid>
                        <TextBlock x:Name="LobbyEmptyStateText"
                                   Text="Session Lobby is empty. Click HOST to start hosting or CLIENT to join a session."
                                   FontSize="12" Foreground="{StaticResource WinUiTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="24,0" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LobbyClientsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#191D24" BorderBrush="#2E3646" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Client Row 0: Avatar, Name, ID, IP:Port, Ping, Speed -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="🎮" FontSize="18" VerticalAlignment="Center" Margin="4,0,10,0" ToolTip="Connected Client" />

                                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" Background="#262626" BorderBrush="#60CDFF" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60CDFF" Visibility="{Binding FallbackIconVisibility}" />
                                                            <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding AvatarVisibility}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#112A38" BorderBrush="#60CDFF" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,7,0">
                                                                <TextBlock Text="CLIENT" FontSize="9.5" FontWeight="Bold" Foreground="#60CDFF" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding IdDisplay}" FontSize="11.5" Foreground="#CBD5E1" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="Handshaked: " FontSize="11" Foreground="{StaticResource WinUiTextMuted}" />
                                                            <TextBlock Text="{Binding IpPortDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6CCB5F" FontFamily="Cascadia Mono, Consolas" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#33280F" BorderBrush="#9E7B22" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"
                                                                Visibility="{Binding CgnatVisibility}"
                                                                ToolTip="This client is behind CGNAT (e.g. Mobile 4G/5G hotspot or ISP CGNAT). Connects at full speed to Hosts with Public WAN / UPnP or VPN.">
                                                            <TextBlock Text="⚠ CGNAT" FontSize="11.5" FontWeight="Bold" Foreground="#FFD86B" FontFamily="Cascadia Mono, Consolas" />
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding StatsVisibility}">
                                                            <Border Background="#12261A" BorderBrush="#285E3B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Ping: " FontSize="11" Foreground="#94A3B8" />
                                                                    <TextBlock Text="{Binding PingDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#6CCB5F" FontFamily="Cascadia Mono, Consolas" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#112233" BorderBrush="#1E4976" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Speed: " FontSize="11" Foreground="#94A3B8" />
                                                                    <TextBlock Text="{Binding SpeedDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Cascadia Mono, Consolas" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Client Row 1: Real-Time Sync Progress Bar & Stage Status -->
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Background="#121418" Foreground="#6CCB5F" BorderThickness="0"
                                                                 VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}"
                                                               FontSize="11" FontWeight="Bold" Foreground="#6CCB5F"
                                                               Margin="8,0,10,0" VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas" />

                                                    <TextBlock Grid.Column="2" Text="{Binding StageText}"
                                                               FontSize="11.5" Foreground="#E2E8F0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4: Smaller Feature Buttons at Bottom -->
        <Border Grid.Row="4" Background="{StaticResource WinUiCardBg}" BorderBrush="{StaticResource WinUiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackupRestoreFeatureBtn" Grid.Column="0"
                        Content="📦 Backup"
                        ToolTip="Backup your current BG3 mods to a drive/folder or restore from an existing backup."
                        Style="{StaticResource WinUiButtonStyle}" Margin="0,0,8,0"
                        Click="BackupRestoreFeatureBtn_Click" />

                <Button x:Name="LocationsSettingsFeatureBtn" Grid.Column="1"
                        Content="⚙ Locations"
                        ToolTip="Configure or auto-detect your Larian Studios AppData folder and Baldur's Gate 3 install folder."
                        Style="{StaticResource WinUiButtonStyle}" Margin="0,0,8,0"
                        Click="LocationsSettingsFeatureBtn_Click" />

                <Button x:Name="ExcludeFeatureBtn" Grid.Column="2"
                        Content="🚫 Exclude"
                        ToolTip="Manage excluded files and folders per category (PAK, JSON, GAMEDATA, LOADORDER) such as english.pak or Armory."
                        Style="{StaticResource WinUiButtonStyle}" Margin="0,0,8,0"
                        Click="ExcludeFeatureBtn_Click" />

                <Button x:Name="SteamAppIdFeatureBtn" Grid.Column="3"
                        Content="🆔 AppID: 1086940"
                        ToolTip="Set Steam AppID: 1086940 for legit Baldur's Gate 3 Steam copy (Default), 480 for Spacewar testing/GOG friends, or a custom AppID."
                        Style="{StaticResource WinUiButtonStyle}" Margin="0,0,8,0"
                        Click="SteamAppIdFeatureBtn_Click" />

                <Button x:Name="OpenModsFolderFeatureBtn" Grid.Column="4"
                        Content="📂 Mods Folder"
                        ToolTip="Open your local Baldur's Gate 3 Mods folder in Windows Explorer."
                        Style="{StaticResource WinUiButtonStyle}" Margin="0,0,8,0"
                        Click="OpenModsFolderFeatureBtn_Click" />

                <Button x:Name="ActivityLogFeatureBtn" Grid.Column="5"
                        Content="📜 Log"
                        ToolTip="Open the real-time Activity Log pop-up window."
                        Style="{StaticResource WinUiButtonStyle}"
                        Click="ActivityLogFeatureBtn_Click" />

                <Button x:Name="StopServerFeatureBtn" Grid.Column="7"
                        Content="⏹ Stop"
                        ToolTip="Stop the active Host server or cancel the current Client sync."
                        Style="{StaticResource WinUiButtonStyle}"
                        Foreground="#FF7A7A"
                        IsEnabled="False"
                        Click="StopServerFeatureBtn_Click" />
            </Grid>
        </Border>

        <!-- 5: Footer Credit Link -->
        <TextBlock Grid.Row="5" HorizontalAlignment="Right" Margin="0,6,4,0" FontSize="11.5">
            <Hyperlink NavigateUri="https://www.nexusmods.com/profile/AlyciaXY"
                       RequestNavigate="AuthorLink_RequestNavigate"
                       Foreground="{StaticResource WinUiTextMuted}"
                       TextDecorations="None"
                       ToolTip="Visit AlyciaX on Nexus Mods (https://www.nexusmods.com/profile/AlyciaXY)">
                <Run Text="Create by AlyciaX" />
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
