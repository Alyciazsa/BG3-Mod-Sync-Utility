# Build outputs & intermediate artifacts
[Dd]ebug/
[Dd]ebugPublic/
src/**/bin/
src/**/obj/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Single-file published binaries (~69 MB) — distribute via GitHub Releases
# (Or commit explicitly with: git add -f release/BG3ModSync.exe)
/*.exe
release/*.exe

# Visual Studio / IDE user state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
project.fragment.lock.json

# Nginx runtime logs & temporary files
tools/nginx/logs/*.log
tools/nginx/logs/*.pid
!tools/nginx/logs/.gitkeep
tools/nginx/temp/*
tools/nginx/conf/bg3modsync_nginx.conf
